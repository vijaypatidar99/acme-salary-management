# Frontend environment variables. Copy to .env.local (git-ignored) to override.
#
# Every VITE_* variable is embedded in the public JavaScript bundle. Never put a secret,
# token, passphrase or credential here.

# Base URL of the Rails API, without a trailing slash.
# Optional in development (defaults to http://localhost:3000); required for production builds.
VITE_API_BASE_URL=http://localhost:3000
