# Backend environment variables. Copy to .env and adjust; .env is git-ignored.
# Rails does not load .env files itself (no dotenv gem). Export the values into your shell:
#   set -a; source .env; set +a
# Nothing here is required for local development: every value has a working default.
# Never commit real credentials.

# Port for `bin/rails server` / `bin/dev` (default 3000).
# PORT=3000

# Overrides config/database.yml. Default is the local Unix socket with the databases
# backend_development and backend_test.
# DATABASE_URL=postgres://localhost/backend_development

# Comma-separated browser origins allowed to call the API (no wildcard). In development
# and test the Vite dev server (http://localhost:5173) is allowed when this is unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Puma threads and the Active Record pool size (default 3 / 5).
# RAILS_MAX_THREADS=3

# Shared demo write key for POST /api/v1/employees/:id/salary_revisions, sent as
# `Authorization: Bearer <key>`. Server-side only: never put it in a frontend VITE_* variable.
# When unset or empty, every write is refused with 403 writes_disabled (fail closed).
# DEMO_WRITE_KEY=

# Seed: `bin/rails db:seed` creates the 10,000 synthetic employees (a no-op if already seeded).
# RESET=1 deletes employees, salary records and rates first. In production the seed refuses to run
# unless ALLOW_PRODUCTION_SEED=1.
# RESET=1
# ALLOW_PRODUCTION_SEED=1

# Production only. Hosting is pending (DR-22), so these are not exercised yet.
# SECRET_KEY_BASE=
# BACKEND_DATABASE_PASSWORD=
# RAILS_LOG_LEVEL=info
